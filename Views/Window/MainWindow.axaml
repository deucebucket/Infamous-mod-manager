<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InfamousModManager.ViewModels"
        xmlns:views="using:InfamousModManager.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="InfamousModManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="InfamousModManager"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        WindowDecorations="None">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <Grid ColumnDefinitions="250, *"
          Background="{DynamicResource ResourceKey=PrimaryBackground}">
        <ContentControl Content="{Binding LeftPanelViewModel}"
                        Grid.Column="0"/>
        <ContentControl Content="{Binding CurrentRightViewModel}"
                        Grid.Column="1"/>
        <Border Grid.Column="1"
                IsVisible="{Binding IsInfoOverlayOpen}"
                Background="#99000000"
                ZIndex="10">
            <Border Width="480"
                    Padding="24"
                    CornerRadius="10"
                    Background="{DynamicResource ResourceKey=SecondaryBackground}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <TextBlock Text="About"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Spacing="10">
                        <TextBlock Text="Application creator: mentally_ill_kid"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Original modding tools: tiffsomniac"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Reverse engineering xpps files: LDD565"
                                   TextWrapping="Wrap" />
                        <TextBlock Text=".NET version: 10.0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="UI framework: Avalonia 12.1.0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            Content="Close"
                            Command="{Binding CloseInfoOverlayCommand}" />
                </Grid>
            </Border>
        </Border>
        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ZIndex="20">
            <Button Classes="window-control"
                    Content="—"
                    ToolTip.Tip="Minimize"
                    Click="MinimizeButton_Click" />
            <Button Classes="window-control window-close"
                    Content="×"
                    ToolTip.Tip="Close"
                    Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
