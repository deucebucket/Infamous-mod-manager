<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfamousModManager.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="600"
             x:Class="InfamousModManager.Views.InfamousFobView"
             x:DataType="vm:InfamousFobViewModel">
  <Grid RowDefinitions="Auto,*" Margin="20">
    <TextBlock Text="InFamous Festival of Blood" FontSize="24" FontWeight="SemiBold" />

    <Grid Grid.Row="1" Margin="0,16,0,0" RowDefinitions="*,*" ColumnDefinitions="*,*">
      <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="16"
              CornerRadius="10" Background="{DynamicResource ResourceKey=SecondaryBackground}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource PrepareTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource PrepareDescription}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding GameFolderPath, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource GameFolderPlaceholder}" />
            <Button Grid.Column="1" Content="…" Width="36" Margin="0"
                    ToolTip.Tip="{DynamicResource BrowseFoldersTooltip}"
                    Click="BrowseGameFolder_Click" />
          </Grid>
          <TextBlock Text="{Binding GameFolderStatus}"
                     IsVisible="{Binding HasGameFolderStatus}"
                     TextWrapping="Wrap" />
          <Button Content="{DynamicResource UnpackGameFiles}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="16"
              CornerRadius="10" Background="{DynamicResource ResourceKey=SecondaryBackground}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource InstallTitle}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{DynamicResource InstallDescription}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="{DynamicResource XppsFilePlaceholder}" />
            <Button Grid.Column="1" Content="…" Width="36" Margin="0"
                    ToolTip.Tip="{DynamicResource BrowseXppsTooltip}" />
          </Grid>
          <Button Content="{DynamicResource InstallMod}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" Padding="16"
              CornerRadius="10" Background="{DynamicResource ResourceKey=SecondaryBackground}">
        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource ExtractTitle}" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="{DynamicResource XppsSourcePlaceholder}" />
            <Button Grid.Column="1" Content="…" Width="36" Margin="0"
                    ToolTip.Tip="{DynamicResource BrowseSourceTooltip}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox PlaceholderText="{DynamicResource OutputFolderPlaceholder}" />
            <Button Grid.Column="1" Content="…" Width="36" Margin="0"
                    ToolTip.Tip="{DynamicResource BrowseOutputTooltip}" />
          </Grid>
          <Button Content="{DynamicResource ExtractXpps}" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" Padding="16"
              CornerRadius="10" Background="{DynamicResource ResourceKey=SecondaryBackground}">
        <Grid RowDefinitions="Auto,*" RowSpacing="10">
          <TextBlock Text="{DynamicResource InstalledModsTitle}" FontSize="18" FontWeight="SemiBold" />
          <ListBox Grid.Row="1">
            <ListBoxItem Content="{DynamicResource ModifiedFilesPlaceholder}" IsEnabled="False" />
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
