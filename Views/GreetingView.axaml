<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="InfamousModManager.Views.GreetingView">
  <Border Background="{DynamicResource ResourceKey=PrimaryBackground}">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
      <TextBlock Text="Welcome to InFamous Mod Manager!"
             FontSize="24"
             TextAlignment="Center"/>
      <TextBlock Text="Please select your game on the left panel"
                 TextAlignment="Center"/>
    </StackPanel>
  </Border>
</UserControl>
