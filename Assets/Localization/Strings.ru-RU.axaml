<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:String x:Key="LanguageLabel">Язык</x:String>
  <x:String x:Key="PrepareTitle">Подготовка файлов к моддингу</x:String>
  <x:String x:Key="PrepareDescription">Выберите папку с файлами игры.</x:String>
  <x:String x:Key="GameFolderPlaceholder">Путь к папке игры</x:String>
  <x:String x:Key="BrowseFoldersTooltip">Обзор папок</x:String>
  <x:String x:Key="UnpackGameFiles">Распаковать файлы</x:String>
  <x:String x:Key="PackedPrepareDescription">Эта версия загружает XPP из архивов install PSARC. Не распаковывайте их; используйте проверенный профиль.</x:String>
  <x:String x:Key="InstallTitle">Установка модов</x:String>
  <x:String x:Key="InstallDescription">Выберите файл мода в формате XPPS.</x:String>
  <x:String x:Key="XppsFilePlaceholder">Путь к файлу .xpps</x:String>
  <x:String x:Key="BrowseXppsTooltip">Обзор XPPS-файлов</x:String>
  <x:String x:Key="InstallMod">Установить мод</x:String>
  <x:String x:Key="PackedInstallTitle">Установка упакованного профиля</x:String>
  <x:String x:Key="PackedInstallDescription">Выберите проверенный профиль install1/install2. Чистая розничная пара нужна только для первой защищённой резервной копии.</x:String>
  <x:String x:Key="PackedProfilePlaceholder">Папка с infamous1.psarc_s и infamous2.psarc_s</x:String>
  <x:String x:Key="CleanRetailPlaceholder">Необязательная папка чистых розничных PSARC</x:String>
  <x:String x:Key="InstallPackedProfile">Установить профиль</x:String>
  <x:String x:Key="RestoreRetail">Восстановить оригинал</x:String>
  <x:String x:Key="ExtractTitle">Распаковка архива XPP/XPPS</x:String>
  <x:String x:Key="XppsSourcePlaceholder">Путь к архиву .xpp или .xpps</x:String>
  <x:String x:Key="BrowseSourceTooltip">Обзор архивов XPP/XPPS</x:String>
  <x:String x:Key="OutputFolderPlaceholder">Папка для распаковки</x:String>
  <x:String x:Key="BrowseOutputTooltip">Обзор папок назначения</x:String>
  <x:String x:Key="ExtractXpps">Распаковать архив</x:String>
  <x:String x:Key="InstalledModsTitle">Установленные моды</x:String>
  <x:String x:Key="ModifiedFilesPlaceholder">Список изменённых файлов появится здесь</x:String>
  <x:String x:Key="ComingSoon">Функциональность скоро будет доступна</x:String>
</ResourceDictionary>
